#!/command/with-contenv bash
# shellcheck shell=bash
set -o errexit -o nounset -o pipefail
umask 077
exec 2>&1

# Disabled and failed optional services stay down instead of restarting.
s6-svc -O .
readonly state=/dev/shm/ovenmediaengine
if [[ -L "$state" ]]; then
    echo "[ERROR] Refusing a symlink for the private live-media state directory"
    exit 1
fi
if [[ ! -f "$state/enabled" ]]; then
    echo "[INFO] OME live media is disabled"
    exit 0
fi
if [[ ! -s "$state/Server.xml" ]]; then
    echo "[ERROR] OME configuration is missing; service stopped"
    exit 1
fi

ulimit -c 0
ulimit -n 4096
export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2
export LD_LIBRARY_PATH=/opt/ovenmediaengine/lib:/opt/ovenmediaengine/lib64
cd "$state"
echo "[INFO] Starting viewer-only OME CPU live media"
if [[ "$(id -u)" -eq 0 ]]; then
    exec s6-applyuidgid -u 1000 -g 1000 -G 1000 \
        /opt/ovenmediaengine/bin/OvenMediaEngine -c "$state"
elif [[ "$(id -u)" -eq 1000 && "$(id -g)" -eq 1000 ]]; then
    exec /opt/ovenmediaengine/bin/OvenMediaEngine -c "$state"
fi
echo "[ERROR] OME must run as UID/GID 1000"
exit 1
