#!/command/with-contenv bash
# shellcheck shell=bash
set -o errexit -o nounset -o pipefail
umask 077
exec 2>&1

s6-svc -O .
readonly config=/config/.live-hls/mediamtx.yml
# Frigate creates this only when its existing HLS manager is enabled. Do not
# create sources or rewrite that manager's configuration while waiting.
for ((attempt = 0; attempt < 120; attempt++)); do
    if [[ -s "$config" ]]; then
        break
    fi
    sleep 1
done
if [[ ! -s "$config" ]]; then
    echo "[INFO] Private HLS has no generated configuration; service stopped"
    exit 0
fi

ulimit -c 0
ulimit -n 4096
export HORIZON_HLS_SHARED_CLOCK=1
if [[ "$(id -u)" -eq 0 ]]; then
    s6-applyuidgid -u 1000 -g 1000 -G 1000 \
        python3 /opt/live-hls/verify.py --config "$config"
    exec s6-applyuidgid -u 1000 -g 1000 -G 1000 \
        /opt/live-hls/bin/mediamtx "$config"
elif [[ "$(id -u)" -eq 1000 && "$(id -g)" -eq 1000 ]]; then
    python3 /opt/live-hls/verify.py --config "$config"
    exec /opt/live-hls/bin/mediamtx "$config"
fi
echo "[ERROR] Private HLS must run as UID/GID 1000"
exit 1
